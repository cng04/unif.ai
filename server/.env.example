# Database (default matches db/docker-compose.yml)
DATABASE_URL=postgresql://unifai:unifai@localhost:5432/unifai

# Models: set OPENROUTER_API_KEY alone, or GEMINI_API_KEY + TYPESAFE_API_KEY
OPENROUTER_API_KEY=
GEMINI_API_KEY=
TYPESAFE_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# JEV_MODEL=jev-latest

# Integrations (optional)
TICKETMASTER_API_KEY=
PHOTON_API_KEY=
PHOTON_PROJECT_ID=

CLIENT_URL=http://localhost:3001
# Public base URL for invite links (/join/<code>), e.g. a Cloudflare tunnel
PUBLIC_URL=http://localhost:8000
# Protects /admin with HTTP basic auth (any username). Set before exposing the server.
ADMIN_PASSWORD=

# Join page: iMessage while Photon seats last (Free: 10, Pro: 100), ASI:One always
# PHOTON_SEAT_LIMIT=10
ASI_AGENT_URL=https://agentverse.ai/agents/details/agent1q2m667tk62j0fttv52areu03q3slpeqphuapztr0gm5c7dmlj3jhq3k5k4m/profile
# ASI_AGENT_HANDLE=@unifyai-onboarding

# Account scraping (Browser Use Cloud). Links are always stored; scraped only when enabled.
BROWSER_USE_API_KEY=
# Group plans (Browser Use event search, on whenever BROWSER_USE_API_KEY is set; defaults in app/config.py)
# PLANS_MAX_COST_USD=0.30
# PLANS_TIMEOUT_S=300
# PLANS_DAYS_AHEAD=14
# PLANS_CANDIDATES=6
# PLANS_CONCURRENCY=4

# Optional OpenRouter models (defaults in app/config.py)
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite     # keywords, interviewer, group judge
# Persona chats. Comma-separate models to rotate pairs across them; each model has its own rate limit.
# OPENROUTER_CHAT_MODEL=openai/gpt-oss-20b,~deepseek/deepseek-v4-flash-latest,z-ai/glm-5.3-flash
# One value per chat model (or one value for all): restrained GPT-OSS, balanced DeepSeek, wild GLM.
# OPENROUTER_CHAT_TEMPERATURES=0.50,0.80,1.05
# Randomized once per pair, then held fixed for its full conversation.
# OPENROUTER_CHAT_TEMPERATURE_JITTER=0.08
# OPENROUTER_CHAT_MAX_TOKENS=512                    # 1-3 sentence turns; keeps credit reservation low
# Native Jev System One model for scoring and the pair judge. Other options include typesafe/jev-1.14
# and typesafe/jev-1.13; comma-separate versions to rotate requests.
# OPENROUTER_JEV_MODEL=~typesafe/jev-latest,typesafe/jev-1.14,typesafe/jev-1.13
# OPENROUTER_RPM=0                                  # per-model RPM cap (0 = unlimited; free OpenRouter accounts cap at 20/min)

# Matching tuning (defaults in app/config.py)
# KEYWORD_COUNT=20
# TOP_M=4
# MAX_CONVERSATION_TURNS=6
# MAX_CONCURRENT_CONVERSATIONS=50
# MIN_GROUP_SIZE=3
# MAX_GROUP_SIZE=8
# GROUP_SOLVER_SECONDS=10.0
