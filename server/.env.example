# Database (default matches db/docker-compose.yml)
DATABASE_URL=postgresql://unifai:unifai@localhost:5432/unifai

# Models: set OPENROUTER_API_KEY alone, or GEMINI_API_KEY + TYPESAFE_API_KEY
OPENROUTER_API_KEY=
GEMINI_API_KEY=
TYPESAFE_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# JEV_MODEL=jev-latest

# Integrations (optional)
TICKETMASTER_API_KEY=
PHOTON_API_KEY=
PHOTON_PROJECT_ID=

CLIENT_URL=http://localhost:3001
# Public base URL for invite links (/join/<code>), e.g. a Cloudflare tunnel
PUBLIC_URL=http://localhost:8000
# Protects /admin with HTTP basic auth (any username). Set before exposing the server.
ADMIN_PASSWORD=

# Join page: iMessage while Photon seats last (Free: 10, Pro: 100), ASI:One always
# PHOTON_SEAT_LIMIT=10
ASI_AGENT_URL=
# ASI_AGENT_HANDLE=@unifyai-onboarding

# Account scraping (Browser Use Cloud). Links are always stored; scraped only when enabled.
SCRAPE_ENABLED=false
BROWSER_USE_API_KEY=
# Group plans (Browser Use event search, on when SCRAPE_ENABLED; defaults in app/config.py)
# PLANS_MAX_COST_USD=0.30
# PLANS_TIMEOUT_S=300
# PLANS_DAYS_AHEAD=14
# PLANS_CANDIDATES=6
# PLANS_CONCURRENCY=4

# Optional OpenRouter models (defaults in app/config.py)
# OPENROUTER_MODEL=google/gemini-3.8-flash          # keywords, interviewer, judges, Jev stand-in
# Persona chats. Comma-separate models to rotate pairs across them; each model has its own rate limit.
# OPENROUTER_CHAT_MODEL=google/gemini-3.7-flash,google/gemini-3.6-flash
# Scoring and the pair judge, comma-separated to rotate the same way (empty = OPENROUTER_MODEL)
# OPENROUTER_JEV_MODEL=google/gemini-3.8-flash,anthropic/claude-haiku-5.5
# OPENROUTER_RPM=18                                 # OpenRouter caps accounts at 20/min per model, even with credits
# OPENROUTER_JEV_REASONING=low                      # reasoning effort for scoring and the pair judge

# Matching tuning (defaults in app/config.py)
# KEYWORD_COUNT=20
# TOP_M=5
# MAX_CONVERSATION_TURNS=12
# MAX_CONCURRENT_CONVERSATIONS=8
# MIN_GROUP_SIZE=4
# MAX_GROUP_SIZE=8
# GROUP_SOLVER_SECONDS=10.0
