    {
      "id": "00Qb1fc1GOiR_Zs7AlN2q",
      "type": "text",
      "x": 1139.3540825875498,
      "y": 2884.838805214424,
      "width": 800,
      "height": 747.5,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0S",
      "roundness": null,
      "seed": 1691378697,
      "version": 30,
      "versionNonce": 122424425,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792227729911,
      "created": 1792226776644,
      "link": null,
      "locked": false,
      "text": "agent tools:\n\nsend_message(text) – The agent talks only by calling this\ntool, and anything else it writes stays private. This gives you\na clean split between private reasoning (“they mentioned bar\ncrawls twice, that’s one of Cynthia’s dealbreakers”) and what\nthe other agent sees. It’s the strongest way to enforce\ndisclosure rules.\n\ntake_note(observation) – A private scratchpad for evidence\nabout compatibility. The judge reads these notes alongside\nthe transcript, so you get more signal than the chat alone.\n\nend_conversation(reason) – Ends the chat in a structured\nway, instead of checking the text for “[END]”.\n\ncheck_availability() / lookup_profile(field) – Lets the agent\nfetch details on demand instead of stuffing everything into\nthe prompt. This matters more as profiles grow.\n\nask_my_human(question) – An escalation path for when\nsomething comes up the profile can’t answer. This is useful\nonce real people are involved.",
      "fontSize": 26,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "agent tools:\n\nsend_message(text) – The agent talks only by calling this tool, and anything else it writes stays private. This gives you a clean split between private reasoning (“they mentioned bar crawls twice, that’s one of Cynthia’s dealbreakers”) and what the other agent sees. It’s the strongest way to enforce disclosure rules.\n\ntake_note(observation) – A private scratchpad for evidence about compatibility. The judge reads these notes alongside the transcript, so you get more signal than the chat alone.\n\nend_conversation(reason) – Ends the chat in a structured way, instead of checking the text for “[END]”.\n\ncheck_availability() / lookup_profile(field) – Lets the agent fetch details on demand instead of stuffing everything into the prompt. This matters more as profiles grow.\n\nask_my_human(question) – An escalation path for when something comes up the profile can’t answer. This is useful once real people are involved.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
