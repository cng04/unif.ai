      "isDeleted": false,
      "boundElements": [],
      "updated": 1792227978104,
      "created": 1792227933993,
      "link": null,
      "locked": false,
      "text": "- Only use what you've actually seen from me. Tag each point\n[observed] if it comes from something I said or did, or\n[inferred] if it's your interpretation. Include a brief example\nwhere you can.",
      "fontSize": 26,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Only use what you've actually seen from me. Tag each point [observed] if it comes from something I said or did, or [inferred] if it's your interpretation. Include a brief example where you can.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "dAUioCAWaJFt5UJXEFnhP",
      "type": "text",
      "x": 301.582609307525,
