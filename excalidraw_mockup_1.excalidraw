      "updated": 1792227729911,
      "created": 1792226690220,
      "link": null,
      "locked": false,
      "text": "{\n  \"public\": {\n    \"name\": \"Cynthia\",\n    \"interests\": [\"climbing\", \"indie games\", \"ramen\"],\n    \"vibe\": \"dry humor, curious, low-key\",\n    \"looking_for\": \"a small crew for weekend adventures\"\n  },\n  \"private\": {\n    \"dealbreakers\": [\"heavy drinking culture\", \"flaky plans\"],\n    \"values\": [\"reliability\", \"curiosity\"],\n    \"energy\": \"introvert, prefers groups under 6\",\n    \"logistics\": {\"area\": \"SF Mission\", \"budget\": \"$\", \"free\":\n[\"weeknights\", \"Sun\"]}\n  }\n}",
      "fontSize": 26,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "{\n  \"public\": {\n    \"name\": \"Cynthia\",\n    \"interests\": [\"climbing\", \"indie games\", \"ramen\"],\n    \"vibe\": \"dry humor, curious, low-key\",\n    \"looking_for\": \"a small crew for weekend adventures\"\n  },\n  \"private\": {\n    \"dealbreakers\": [\"heavy drinking culture\", \"flaky plans\"],\n    \"values\": [\"reliability\", \"curiosity\"],\n    \"energy\": \"introvert, prefers groups under 6\",\n    \"logistics\": {\"area\": \"SF Mission\", \"budget\": \"$\", \"free\": [\"weeknights\", \"Sun\"]}\n  }\n}",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
