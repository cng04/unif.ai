      "created": 1792227933993,
      "link": null,
      "locked": false,
      "text": "- Prefer specific details over generic traits. \"Will happily spend\nan hour comparing ramen broths\" beats \"likes food.\"",
      "fontSize": 26,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Prefer specific details over generic traits. \"Will happily spend an hour comparing ramen broths\" beats \"likes food.\"",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
