# Any long random phrase. Keep it secret and stable: it determines the agent's address.
AGENT_SEED=
# The bot's HTTP channel (run onboarding/ with CHANNELS=http, or CHANNELS=photon,http)
BOT_URL=http://127.0.0.1:8787/message
# Optional shared secret; set the same RELAY_TOKEN in onboarding/.env
RELAY_TOKEN=

# Agentverse → profile → API Keys (used by connect.py)
AGENTVERSE_API_KEY=

# Short @handle for ASI:One mentions, without the "@" (must be unique on Agentverse)
AGENT_HANDLE=
