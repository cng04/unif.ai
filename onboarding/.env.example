# Claude (interviewer)
ANTHROPIC_API_KEY=
# INTERVIEW_MODEL=claude-opus-5-5

# ASI:One (asi1 models; used before OpenRouter when set) — key from asi1.ai
ASI_ONE_API_KEY=
# ASI_ONE_MODEL=asi1

# OpenRouter — free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free   # interviewer model when ANTHROPIC_API_KEY is blank
# LOG_MODEL=1                        # print which free model answered

# Postgres from ../db (users who joined via /join/<code>), so the bot can greet them by name
# unif.ai server (account scraping goes through POST /users/{id}/social-links)
SERVER_URL=http://localhost:8000
# Match the server's SCRAPE_ENABLED: when on, the bot waits briefly for scrape results before the interview
SCRAPE_ENABLED=false
# Web app (client/). After onboarding the bot sends people their page, APP_URL/u/<user id>.
# Must be reachable from their phone in production; leave blank to send no link.
APP_URL=http://localhost:3001
DATABASE_URL=postgresql://unifai:unifai@localhost:5432/unifai
# Pool for people who text without a join link (the seed's "LA Hacks Demo")
DEFAULT_UNIVERSE_ID=00000000-0000-0000-0000-000000000001

# Photon 2.0 — app.beta.photon.codes → your project → API keys
# Key needs project:read + project:write (and platforms:write for `npm run assign`)
PHOTON_API_KEY=pho_sk_...
PHOTON_PROJECT_ID=pho_prj_...
# PHOTON_DEBUG=1   # log events the bot skips, to confirm the event shape
# PHOTON_TYPING=1   # typing indicators (dedicated lines; shared lines reject them)

# Channels to run: photon (iMessage), http (ASI:One relay). Comma-separated, no spaces.
CHANNELS=photon,http
